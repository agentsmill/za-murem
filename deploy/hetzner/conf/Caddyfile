# Gra pod adresem z certyfikatem (SITE, na przykład 1-2-3-4.sslip.io), goły adres IP przekierowuje na niego.
{$SITE} {
	encode zstd gzip
	root * /srv/www
	@html path / /index.html /v03/ /v03/index.html
	header @html Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}

http://{$IP} {
	redir https://{$SITE}{uri}
}
