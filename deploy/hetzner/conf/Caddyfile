# Gra pod adresem z certyfikatem (SITE, na przykład 1-2-3-4.sslip.io), goły adres IP przekierowuje na niego.
# /api/* idzie do serwera gry sieciowej (kontener api), reszta to pliki gry. Bez logów dostępu (adresy IP, RODO).
{$SITE} {
	encode zstd gzip
	handle /api/* {
		request_body {
			max_size 4MB
		}
		reverse_proxy api:8787
	}
	handle {
		root * /srv/www
		@html path / /index.html /v03/ /v03/index.html
		header @html Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

http://{$IP} {
	redir https://{$SITE}{uri}
}
