# Pliki gry za Caddy innej aplikacji (HTTPS robi tamten): tylko http w sieci Dockera, bez logów dostępu.
:80 {
	encode zstd gzip
	root * /srv/www
	@html path / /index.html /v03/ /v03/index.html
	header @html Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}
