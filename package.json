{
  "name": "za-murem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Za Murem: spółdzielnia po upadku. Pikselowa gra na prawdziwym osiedlu z OpenStreetMap.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "bot": "node tools/bot.ts",
    "bot:zombie": "node tools/bot-zombie.ts",
    "bot:zombie:siatka": "node tools/bot-zombie-siatka.ts",
    "bot:osada": "node tools/bot-osada.ts",
    "bot:v03": "node tools/bot-v03.ts",
    "bot:surowce": "node tools/bot-surowce.ts",
    "bot:praca": "node tools/bot-praca.ts",
    "bot:cele": "node tools/bot-cele.ts",
    "demos": "node tools/make-demos.ts",
    "atlasy": "node tools/atlasy.ts",
    "animacje": "node tools/animacje.ts",
    "dane:gminy": "node tools/dane-gminy.ts",
    "dane:kraj": "node tools/dane-kraj.ts",
    "dane:imiona": "node tools/dane-imiona.ts",
    "dane:odmiana": "node tools/dane-odmiana.ts",
    "mieszkancy": "node tools/mieszkancy.ts",
    "shots": "node tools/shots.ts",
    "perf": "node tools/perf.ts",
    "determinizm": "node tools/determinizm.ts"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
